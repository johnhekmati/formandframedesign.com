/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/
  Cache-Control: public, max-age=300, must-revalidate

/index.html
  Cache-Control: public, max-age=300, must-revalidate

/css/*
  Cache-Control: public, max-age=14400, must-revalidate

# Version assets via ?v= query when content changes. Shorter TTL limits poison window
# if a path is ever requested before deploy propagates.
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/video/*
  Cache-Control: public, max-age=3600, must-revalidate

# Never long-cache HTML — avoids serving new markup against a poisoned ?v= stylesheet URL
/
  Cache-Control: public, max-age=60, must-revalidate

/index.html
  Cache-Control: public, max-age=60, must-revalidate

/*.html
  Cache-Control: public, max-age=60, must-revalidate

# Claimable client pitches under /tias — short HTML TTL; allow geolocation for nearest-store
# Keep unpaid pitches out of search / polite crawlers (URL still works for private shop)
/tias/*
  Cache-Control: public, max-age=60, must-revalidate
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  X-Robots-Tag: noindex, nofollow

# Short TTL while pitch is actively iterating — long CSS cache + ?v= poison
# (request new token before deploy lands) kept We Hear You right-docked after left-align shipped
/tias/css/*
  Cache-Control: public, max-age=60, must-revalidate

/tias/assets/*
  Cache-Control: public, max-age=3600, must-revalidate
